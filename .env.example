# ==============================================================================
# BULLION PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these variables under Project Settings -> Environment Variables.
# NEVER commit real credentials or .env / .env.local files to source control.
# ==============================================================================

# ---- DATABASE (MySQL / Amazon RDS / PlanetScale / Self-hosted) ----
# DATABASE_URL: Standard MySQL connection URI used by Sequelize & Better Auth.
# (Server-only | Required in Production / Preview / Development)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/bullion_db"

# Or individual MySQL connection parameters:
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="password"
MYSQL_DATABASE="bullion_db"

# Optional max pool size per runtime container (default: 10)
DB_POOL_MAX="10"

# ---- BETTER AUTH ----
# BETTER_AUTH_SECRET: High-entropy secret key for signing session tokens (min 32 chars).
# Generate with: openssl rand -base64 32
# (Server-only | Required in Production / Preview)
BETTER_AUTH_SECRET="your-32-char-minimum-production-auth-secret"

# BETTER_AUTH_URL: Public canonical URL of the deployed application.
# (Server-only | Required in Production, e.g. https://bulion.vercel.app)
BETTER_AUTH_URL="https://your-bullion-deployment.vercel.app"

# ---- APPLICATION / CLIENT CONFIGURATION ----
# NEXT_PUBLIC_APP_URL: Public client-side origin for metadata and client auth.
# (Public / Client-safe | Required in Production)
NEXT_PUBLIC_APP_URL="https://your-bullion-deployment.vercel.app"

# ---- SYSTEM LOGGING ----
# Set to "true" only when verbose service execution debugging is required.
DEBUG="false"
